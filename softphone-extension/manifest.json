{
  "manifest_version": 3,
  "name": "Comunic.SIP",
  "version": "0.1.0",
  "description": "Softphone do Comunic Chat integrado ao Yeastar P-Series.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Comunic.SIP",
    "default_icon": { "128": "icon-128.png" }
  },
  "icons": { "128": "icon-128.png" },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["offscreen", "storage", "notifications"],
  "optional_host_permissions": ["https://*/*"],
  "minimum_chrome_version": "116"
}
