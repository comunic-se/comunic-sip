# Copie para .env e preencha. O .env NUNCA vai para o git.
# Referência completa: README.md (tabela "Variáveis de ambiente").

# --- Servidor ---
PORT=8787
# 0.0.0.0 dentro do container; 127.0.0.1 se rodar local sem Docker
HOST=0.0.0.0
# true quando a API fica atrás de reverse proxy (lê X-Forwarded-*)
TRUST_PROXY=false

# --- Banco (Prisma / Postgres) ---
# Dev: Postgres do docker-compose publicado em 127.0.0.1:5433
DATABASE_URL=postgresql://comunic:comunic@localhost:5433/comunicsip
# Senha do Postgres. OBRIGATÓRIA em produção (docker-compose.yml); use uma senha forte.
# No dev (docker-compose.dev.yml) o padrão é comunic.
DB_PASSWORD=comunic

# --- Segredos (gere valores novos em cada ambiente) ---
# Chave AES-256-GCM que cifra os segredos no banco (32 bytes em base64):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Segredo do JWT do painel/extensão:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
EXTENSION_JWT_SECRET=

# --- Linkus SDK ---
# Validade da assinatura do ramal em segundos (padrão 12 h, mínimo 30 min)
# SIGN_TTL_SECONDS=43200

# --- Coleta de chamadas (CDR) ---
# CDR_SYNC_ENABLED=true
# CDR_SYNC_INTERVAL_S=120
# CDR_BACKFILL_DAYS=30
# PBX_TIMEZONE_OFFSET=-03:00

# --- Comunic Chat (Helena) ---
HELENA_BASE=https://api.wts.chat

# --- Acesso web ---
# Origens liberadas no CORS, separadas por vírgula. Vazio = nega cross-origin.
ALLOWED_ORIGINS=
# Quem pode embutir o /painel em iframe (padrão abaixo se vazio)
# PANEL_FRAME_ANCESTORS='self' https://*.wts.chat https://*.flw.chat

# --- Só para scripts/seed-*.mjs (cadastro do PBX no banco) ---
# A API lê o PBX do banco; estas variáveis não são usadas em tempo de execução.
PBX_BASE_URL=https://seu-pbx.exemplo.com:8088
SDK_ACCESS_ID=
SDK_ACCESS_KEY=
